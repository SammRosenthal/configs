# Machine-specific zsh settings and secrets.
# Copy to ~/.config/zsh/local.zsh. Sourced at the end of ~/.zshrc.
# NEVER commit the real file.

# API tokens (values from your password manager), e.g.:
# export SOME_API_TOKEN="<from password manager>"

# Tools that only exist on this machine, e.g.:
# export PATH="$HOME/.some-tool/bin:$PATH"
